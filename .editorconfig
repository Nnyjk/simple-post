# EditorConfig — https://editorconfig.org
# Keep editor defaults aligned with cargo fmt / Prettier (see .prettierrc).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
# cargo fmt (rustfmt default: 4 spaces)
indent_size = 4

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

[*.md]
# Trailing two spaces are Markdown hard line breaks.
trim_trailing_whitespace = false
