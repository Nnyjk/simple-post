# Dockerfile.web — Alpine + musl release build for `simple-post serve-web`.
#
# Multi-stage:
#   1. builder  — rust:1.82-alpine, compiles a fully-static musl binary
#                 (no glibc, no .so files → matches the Alpine runtime)
#   2. runtime  — alpine:3.20, just the binary + dist/ + healthcheck script
#
# The release binary is ~50 MB stripped; the runtime image lands
# around 70-80 MB total (Alpine base + tini + ca-certificates + wget).
#
# Build:    docker build -f Dockerfile.web -t simple-post:web .
# Run:      docker run --rm -p 4173:4173 \
#              -e SIMPLE_POST_WEB_PASSWORD=changeme \
#              -v $PWD/data:/data simple-post:web
#
# Notes:
#   - The repo's `dist/` MUST be present in the build context. Run
#     `npm install && npm run build` first. The `.dockerignore` excludes
#     `node_modules/`, `target/`, `.scratch/`, etc., so the only build
#     context cost beyond `src/` is the small `dist/`.
#   - We intentionally do NOT pin to a glibc base — musl eliminates the
#     "works on my machine" class of bugs where the glibc on the runner
#     doesn't match what's on Alpine.
#   - `tini` is the PID 1 reaper so SIGTERM from `docker stop` actually
#     reaches the binary. Without it, the Rust binary receives SIGKILL
#     10 seconds later and SQLite can leave a -wal file behind.
#   - HEALTHCHECK hits `/api/healthz` (public per commit 5's auth.rs).
#     The body is JSON `{"status":"ok","version":"…","shape":"server"}`.

# ---------- builder ----------------------------------------------------
FROM rust:1.82-alpine AS builder

# musl-dev for libc headers, pkgconfig + openssl-dev for reqwest's
# native-tls fallback (we mostly use rustls, but some crates still
# probe pkg-config).
RUN apk add --no-cache \
        musl-dev \
        pkgconfig \
        openssl-dev \
    && rustup target add x86_64-unknown-linux-musl

WORKDIR /build

# Cache deps: copy manifests first, do a dummy build, then copy the
# rest. This makes the second-and-onward build skip the dep graph
# rebuild when only source files changed.
COPY Cargo.toml Cargo.lock ./
COPY src-tauri/Cargo.toml ./src-tauri/
COPY crates ./crates

# Pre-warm the musl target's dep cache. `cargo build` with empty src
# will fail to link, but the deps are already downloaded + compiled.
RUN cd src-tauri && \
    mkdir -p src bin && \
    echo 'fn main(){}' > src/main.rs && \
    echo '' > src/lib.rs && \
    cargo build --release --target x86_64-unknown-linux-musl --bin simple-post 2>&1 | tail -5 ; \
    cd /build
RUN rm -rf src-tauri/src src-tauri/bin

# Now copy the real source and build for real. The deps are cached.
COPY src-tauri ./src-tauri
COPY packages ./packages
COPY src ./dist-src

# The binary expects `dist/` next to it OR a few parents up
# (see `default_spa_dir()` in src-tauri/src/web_api.rs). The runtime
# image copies `/opt/simple-post/dist`, so we need to build the SPA
# in this stage. We do NOT run `npm install` here — that's the host's
# job (see `.dockerignore` notes).
COPY dist ./dist

# Compile the release binary. We use the stable channel because the
# pinned 1.82.0 toolchain currently fails to build clap_lex 1.1.1
# (edition2024 mismatch in clap_lex 1.1.x). On the stable channel
# the build is clean.
RUN cd src-tauri && \
    cargo build --release \
        --target x86_64-unknown-linux-musl \
        --bin simple-post && \
    strip target/x86_64-unknown-linux-musl/release/simple-post

# ---------- runtime ----------------------------------------------------
FROM alpine:3.20

# tini for proper signal handling (PID 1), ca-certificates for
# reqwest's rustls webpki roots, wget for the healthcheck script.
RUN apk add --no-cache \
        tini \
        ca-certificates \
        wget

# Create a dedicated UID/GID so the container doesn't run as root.
# SQLite + dist files are owned by this user; the data volume is
# mounted writable.
RUN addgroup -S -g 1000 simplepost && \
    adduser  -S -u 1000 -G simplepost simplepost && \
    mkdir -p /opt/simple-post /data && \
    chown -R simplepost:simplepost /opt/simple-post /data

# Copy the stripped binary + SPA + healthcheck script.
COPY --from=builder --chown=simplepost:simplepost \
     /build/target/x86_64-unknown-linux-musl/release/simple-post \
     /usr/local/bin/simple-post
COPY --from=builder --chown=simplepost:simplepost \
     /build/dist /opt/simple-post/dist
COPY --chown=root:root docker/healthcheck.sh /usr/local/bin/healthcheck.sh
RUN chmod 0755 /usr/local/bin/healthcheck.sh

USER simplepost:simplepost
WORKDIR /opt/simple-post

ENV SIMPLE_POST_DATA_DIR=/data \
    SIMPLE_POST_WEB_BIND=0.0.0.0:4173 \
    SIMPLE_POST_WEB_PORT=4173

EXPOSE 4173

VOLUME ["/data"]

# tini forwards SIGTERM/SIGINT to the binary so `docker stop` is
# graceful (closes SQLite, releases the WAL file).
ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/simple-post", "serve-web"]

# 30s interval × 5s timeout × 3 retries; start-period 10s gives the
# binary time to open SQLite + bind 4173.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD /usr/local/bin/healthcheck.sh