{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Simple Post",
  "version": "0.1.34",
  "identifier": "com.simplepost.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Simple Post",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Desktop API client with built-in MCP",
    "longDescription": "A modern API debugger for Windows 10/11 with built-in MCP Server for AI collaboration."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVGRkFDOTFGRUJBRjNCMTYKUldRV082L3JIOG42WDlDOUd5N3k4K3U3Q3VXczV0K1RQTk9HUGFlODdOYTlZVkhOekJ5QWdRRGgK",
      "endpoints": ["https://github.com/Nnyjk/simple-post/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
