# .env.example — 复制为 .env 并填写。docker compose 会自动加载 .env。
#
# compose 本身不强制要求设置口令：未设置 SP_WEB_PASSWORD 时会取空字符串，
# 空口令意味着 `auth_middleware` 为 no-op，/api/* 与 /mcp 对所有调用方开放。
# 容器不会因此拒绝启动，首次执行 `docker compose --project-directory . -f docker/docker-compose.yml up`
# 前务必自行配置。

# 必填：/api/* 与 /mcp 的 Bearer 口令。使用长且随机的字符串；
# auth.rs 使用常量时间比较。
SP_WEB_PASSWORD=changeme-please-set-me

# 可选：宿主机映射端口（默认为 4173）。
SP_WEB_BIND=4173

# 可选：镜像名与标签。默认 `simple-post:local` 为
# `docker build -f docker/Dockerfile -t simple-post:local .` 生成的标签。
# 指向已发布的镜像可跳过本地构建：
#   SP_IMAGE=ghcr.io/nnyjk/simple-post:0.1.38
SP_IMAGE=

# 可选：若在 nginx/Caddy 后以子路径（如 https://host/sp/）反代此容器，
# 设为 "/sp"，使路由器挂载到该前缀下。裸机部署保持留空。
SP_PUBLIC_BASE_PATH=

# 可选：日志过滤级别。默认保留 info 及以上级别；
# 生产排查可收紧为 `info,simple_post=debug,tower_http=warn`。
SP_RUST_LOG=info,simple_post=info,tower_http=info

# 可选：用户在更新对话框中点击「立即执行更新」时，`POST /api/update/apply` 所执行的命令。
# 留空 = 未声明：对话框将显示 `docker pull` 命令行，由用户在宿主机手动执行。
#
# 此项仅在同时配置了 SP_WEB_PASSWORD 时生效 —— `applyEnabled` 判据为
# `password_mode && command present`，未设置口令时返回 403。
#
# 命令由容器内的 bash 执行，而镜像运行阶段为 `debian:bookworm-slim`，
# 仅包含服务端二进制文件与 `bash /dev/tcp` 健康探针（无 docker CLI，无 curl/wget/nc）。
# 因此命令必须限制在 bash 与 coreutils 内 —— 例如向负责执行 `docker compose pull` 的
# 旁车或宿主 agent 发送 POST 请求。挂载宿主 docker socket 并无作用：
# 镜像内没有 docker 可执行文件，安装它会破坏「运行阶段不安装任何多余工具」的原则。
SP_UPDATE_COMMAND=
