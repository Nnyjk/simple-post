# .env.example — copy to .env and fill in. docker compose loads .env
# automatically.
#
# The password is NOT enforced by compose: an unset SP_WEB_PASSWORD becomes
# an empty string, and an empty password means `auth_middleware` is a
# no-op — /api/* and /mcp answer every caller. Nothing refuses to start,
# so set it yourself before the first `docker compose --project-directory . -f docker/docker-compose.yml up`.

# REQUIRED: bearer password for /api/* + /mcp. Pick something long and
# random; commit 5's auth.rs uses constant-time compare.
SP_WEB_PASSWORD=changeme-please-set-me

# OPTIONAL: host port to bind (default 4173).
SP_WEB_BIND=4173

# OPTIONAL: image name and tag. Default `simple-post:local` is the tag that
# `docker build -f docker/Dockerfile -t simple-post:local .` produces. Point it at the published
# image to skip the local build:
#   SP_IMAGE=ghcr.io/nnyjk/simple-post:0.1.34
SP_IMAGE=

# OPTIONAL: if you front this container with nginx/Caddy at a subpath
# like https://host/sp/, set this to "/sp" so the router nests under
# that prefix. Leave empty for bare-host deployments.
SP_PUBLIC_BASE_PATH=

# OPTIONAL: log filter. Default keeps everything info+; tighten to
# `info,simple_post=debug,tower_http=warn` for prod triage.
SP_RUST_LOG=info,simple_post=info,tower_http=info

# OPTIONAL: the command `POST /api/update/apply` runs when a user clicks
# 「立即执行更新」 in the update dialog. Empty = not declared: the dialog shows
# the `docker pull` line and the user runs it on the host.
#
# It only takes effect together with SP_WEB_PASSWORD — `applyEnabled` is
# `password_mode && command present`, so an unset password answers 403.
#
# The command runs with bash inside the container, and the runtime stage of
# the image is `debian:bookworm-slim` with only the server binary and the
# `bash /dev/tcp` health probe (no docker CLI, no curl/wget/nc). So it has to
# stay within bash + coreutils — e.g. POST to a sidecar / host agent that runs
# `docker compose pull`. Mounting the host docker socket does not help: there
# is no docker executable in the image to use it, and installing one would
# undo the "runtime stage installs nothing" premise.
SP_UPDATE_COMMAND=
