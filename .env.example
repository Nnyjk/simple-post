# .env.example — copy to .env and fill in. docker compose loads .env
# automatically and refuses to start when SP_WEB_PASSWORD is unset.

# REQUIRED: bearer password for /api/* + /mcp. Pick something long and
# random; commit 5's auth.rs uses constant-time compare.
SP_WEB_PASSWORD=changeme-please-set-me

# OPTIONAL: host port to bind (default 4173).
SP_WEB_BIND=4173

# OPTIONAL: if you front this container with nginx/Caddy at a subpath
# like https://host/sp/, set this to "/sp" so the router nests under
# that prefix. Leave empty for bare-host deployments.
SP_PUBLIC_BASE_PATH=

# OPTIONAL: log filter. Default keeps everything info+; tighten to
# `info,simple_post=debug,tower_http=warn` for prod triage.
SP_RUST_LOG=info,simple_post=info,tower_http=info