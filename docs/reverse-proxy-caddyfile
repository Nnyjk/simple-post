# docs/reverse-proxy-caddyfile
#
# Reference Caddyfile for putting the simple-post serve-web shape
# behind a path prefix (`/sp` here). Drop into your Caddy config dir
# as `simple-post.caddyfile`, or include via the Caddyfile:
#
#     import /etc/caddy/snippets/simple-post.caddyfile
#
# The binary MUST be started with `--public-base-path /sp` (or
# SIMPLE_POST_PUBLIC_BASE_PATH=/sp) — otherwise the binary serves at
# `/` and Caddy's `/sp` prefix routes 404.
#
# Tested with Caddy 2.7. TLS is auto-provisioned by Caddy (zero-conf
# Let's Encrypt when DNS allows); remove the `tls` directive and the
# `email` line if you're not using ACME.

{
    # ACME account email (required for Let's Encrypt HTTP-01 challenges).
    # Override per-host via the `email` global option in your main Caddyfile.
    email ops@simple-post.lan
}

simple-post.lan {
    # ---------------------------------------------------------------------
    # Health probes — hit them at the bare path so Docker / k8s liveness
    # probes keep working even when the prefix is in use.  These are
    # public per auth.rs::is_public_path.
    # ---------------------------------------------------------------------
    reverse_proxy 127.0.0.1:4173 {
        @healthz path /healthz /api/healthz /mcp/healthz
        # `path` matcher is set above; keep the loop tight:
        to 127.0.0.1:4173
    }

    # ---------------------------------------------------------------------
    # Everything else under /sp/ — strip the /sp prefix so the binary
    # sees /api/projects, /mcp, /assets/* etc.
    #
    # Note: Caddy's `rewrite` + `reverse_proxy` is the standard pattern
    # for path-stripping.  The `uri_strip_prefix` directive is simpler
    # and ships with Caddy 2.7+.
    # ---------------------------------------------------------------------
    reverse_proxy 127.0.0.1:4173 {
        # When the request path starts with /sp/, strip it.
        @stripped path /sp/*
        rewrite @stripped {path_regexp.strip_prefix /sp}

        # Forwarding the Bearer header from the browser to the backend
        # is Caddy's default — no extra `request_header` needed. The
        # `header_up` block below only customizes what we want forwarded;
        # Authorization is already on the allow-list by default.

        # Healthcheck: Caddy pings /api/healthz; the binary answers 200
        # without auth, so this works even when SIMPLE_POST_WEB_PASSWORD
        # is set. (`/healthz` is the legacy alias; either works.)
        health_uri /api/healthz
        health_interval 30s
        health_timeout 5s

        # Streaming for SSE (v0.3+ MCP streamable-http).
        flush_interval -1
    }

    # ---------------------------------------------------------------------
    # Everything outside /sp and the three probe paths → 404.
    # ---------------------------------------------------------------------
    @blocked not path /healthz /api/healthz /mcp/healthz /sp /sp/*
    respond @blocked "Not Found" 404
}

# -----------------------------------------------------------------------------
# Optional: redirect /sp → /sp/ for clean UX. Place this in the same site
# block as the reverse_proxy, above the @stripped matcher.
#
#     redir /sp /sp/ 301
#
# -----------------------------------------------------------------------------
# Optional: HTTP→HTTPS upgrade at the listener level.
#
#     auto_https disable_redirects
#
# (Caddy auto-redirects HTTP→HTTPS by default; only set this if you have
# a different redirect policy in your main Caddyfile.)
# -----------------------------------------------------------------------------