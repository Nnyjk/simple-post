#!/usr/bin/env bash
# packages/simple-post-mcp/bin/simple-post-mcp
#
# npm wrapper entry point. Resolves the platform-native binary that
# ships inside the npm package (`./native/<platform>-<arch>/simple-post-mcp[.exe]`)
# and forwards every argument straight through. The native binary does
# all the work; this shell script only handles the cross-platform
# dispatch.
#
# Why a wrapper (not just `bin: { "simple-post-mcp": "native/..." }`):
# npm only auto-creates a shim for executables on Linux/macOS — on
# Windows it copies the file, but on macOS arm64 dev installs it
# silently picks the wrong arch. A small Node script (postinstall.mjs)
# inspects `process.platform` / `process.arch` and symlinks the
# correct binary into `native/current` so users always get the right
# one, regardless of how they invoke the package.

set -euo pipefail

# Locate the directory holding this file, then the package root.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PACKAGE_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
NATIVE_DIR="$PACKAGE_ROOT/native/current"

if [[ ! -x "$NATIVE_DIR/simple-post-mcp" ]]; then
  echo "[simple-post-mcp] native binary missing at $NATIVE_DIR/simple-post-mcp" >&2
  echo "[simple-post-mcp] try: npm install --force @simple-post/mcp-server" >&2
  exit 127
fi

exec "$NATIVE_DIR/simple-post-mcp" "$@"