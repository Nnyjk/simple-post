{
  "name": "simple-post",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Modern desktop API tool with built-in MCP for AI collaboration",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:tests": "node scripts/run-mcp-tests.cjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "tauri": "tauri",
    "mcp:repl": "node scripts/mcp-repl.mjs",
    "test:mcp": "node scripts/mcp-integration.test.mjs",
    "test:proxy": "node scripts/proxy-integration.test.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:debug": "tauri build --debug",
    "tauri:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test": "tsx --test src/lib/http-build.test.ts src/lib/http.test.ts src/stores/__tests__/mcp-slice.test.ts src/stores/__tests__/crud-slice.test.ts",
    "test:watch": "tsx --watch --test src/lib/http-build.test.ts src/lib/http.test.ts src/stores/__tests__/mcp-slice.test.ts src/stores/__tests__/crud-slice.test.ts"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@gsap/react": "^2.1.2",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-sql": "^2.0.0",
    "@uiw/react-codemirror": "^4.23.0",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "tailwind-merge": "^2.5.4",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
