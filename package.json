{
  "name": "simple-post",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "description": "Modern desktop API tool with built-in MCP for AI collaboration",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "vite",
    "dev:split": "node scripts/dev-split.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:openapi": "cargo run -q -p simple-post-interchange --example export_sample -- .scratch/openapi-export-sample.yaml && redocly lint .scratch/openapi-export-sample.yaml",
    "fmt": "cargo fmt --all",
    "fmt:check": "cargo fmt --all --check",
    "clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run lint:openapi && npm run fmt:check && npm run clippy",
    "build:tests": "node scripts/run-mcp-tests.cjs",
    "e2e:preflight": "node scripts/e2e/preflight.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "icons": "tauri icon src-tauri/app-icon.svg -o src-tauri/icons",
    "mcp:repl": "node scripts/mcp-repl.mjs",
    "test:mcp": "node scripts/mcp-integration.test.mjs",
    "test:web:auth": "node scripts/test-web-auth.mjs",
    "test:web:basepath": "node scripts/test-web-basepath.mjs",
    "perf:bench": "node scripts/perf-bench.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:debug": "tauri build --debug",
    "tauri:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test": "node scripts/run-tests.mjs",
    "test:watch": "node scripts/run-tests.mjs --watch"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@gsap/react": "^2.1.2",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-fs": "^2.4.4",
    "@uiw/react-codemirror": "^4.25.12",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.59.0",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
