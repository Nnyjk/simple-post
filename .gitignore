# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/
*.local

# Editor / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS
Thumbs.db

# TypeScript build info
*.tsbuildinfo

# Local build/debug artifacts
build-exit.txt
build-output.txt

# Ad-hoc / backup scripts (kept locally, not for repo)
*.tmp.cjs
*.tmp.ts
*.removed
*.bak

# Ad-hoc agent / human scratch dirs; lets future worker slices drop debug files locally
# without polluting `git status`.
.scratch/
scripts/.scratch/
.playwright-mcp/

# Runtime data / local agent state
.minimax/

# Environment
.env
.env.local
.env.*.local

# Coverage / cache
coverage/
.cache/
.parcel-cache/
.next/
.nuxt/
.vite/
.turbo/

# Tauri
src-tauri/target/
src-tauri/gen/

# Cargo workspace (commit 3: src-tauri became a member of the workspace
# rooted at this directory, so cargo now drops build artifacts into
# `<repo-root>/target/` instead of `src-tauri/target/`. Keep both
# rules so historical `src-tauri/target/` artifacts don't accidentally
# surface again if the workspace is ever rolled back).
/target/

# Agent worktrees created by the desktop runtime: `.worktrees/<session>/`
# is a full second checkout of this repo. Untracked here so it never shows
# up in `git status`; see `.prettierignore` and `eslint.config.js` for the
# matching lint-side ignores — without all three, the tooling crawls into
# the worktree and reports *its* files as if they belonged to this tree.
/.worktrees/

# 本机 agent 的流程与技能文档（`skills/`）：只服务这台机器上的会话，不随仓库
# 发布，也不进线上仓库——内容里带本机的推送/评审配方与临时取舍，公开仓库里
# 既无读者也会过期。整目录忽略，条目按主题分目录；`.prettierignore` 与
# `eslint.config.js` 里有配套的 lint 侧忽略，三处要一起改。
/skills/
