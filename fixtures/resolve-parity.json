{
  "$comment": "两侧请求准备规则的一致性样本。Rust 的 `resolve_endpoint`（MCP 端）与 TS 的 `prepareRequest`（桌面端）读同一份本文件，产出必须逐字节相同。两份实现各写一遍规则，故只有一份共享样本才能钉住它们没分叉。`expected.missingVars` 与 `expected.missingPathParams` 比的是**集合**而非顺序：两侧收集未解析项的次序各自是本地的（渲染层按它渲染告警胶囊，MCP 侧按它报 `_missing_vars`），契约只承诺「哪些变量没解析出来」「哪个路径占位符没取到值」。multipart 另有一份样本（`multipart-parity.json`），因为它的 boundary 每次现生成、值无法写死。`input.proxy` 在场时 base URL 与代理一起住在环境里（环境 × 模块）那一格：渲染进程那一侧直接拿两个值，MCP 那一侧的 `resolve_endpoint` 只从格子里读代理，故这类用例在两侧走的是不同的取数路径。`input.proxy` 缺席时 base URL 走端点自己的 override，不套代理。",
  "cases": [
    {
      "name": "变量替换 + query + bearer 鉴权 + json body",
      "env": {
        "host": "api.example.test",
        "token": "abc",
        "userId": "42"
      },
      "input": {
        "method": "POST",
        "urlPath": "/users/{{userId}}",
        "baseUrl": "https://{{host}}/v1",
        "params": [
          { "id": "p1", "key": "page", "value": "1", "enabled": true },
          { "id": "p2", "key": "skip", "value": "x", "enabled": false }
        ],
        "headers": [{ "id": "h1", "key": "X-Token", "value": "Bearer {{token}}", "enabled": true }],
        "body": { "mode": "json", "content": "{\"id\":\"{{userId}}\"}" },
        "auth": { "kind": "bearer", "bearer": "{{token}}" }
      },
      "expected": {
        "url": "https://api.example.test/v1/users/42?page=1",
        "headers": [
          ["X-Token", "Bearer abc"],
          ["Content-Type", "application/json"],
          ["Accept", "application/json"],
          ["Authorization", "Bearer abc"]
        ],
        "body": "{\"id\":\"42\"}",
        "missingVars": []
      }
    },
    {
      "name": "apikey 落在 query 上 + form body",
      "env": {
        "key": "k-1"
      },
      "input": {
        "method": "POST",
        "urlPath": "/items",
        "baseUrl": "https://api.example.test",
        "params": [],
        "headers": [],
        "body": { "mode": "form", "content": "name=ada" },
        "auth": {
          "kind": "apikey",
          "apikey": { "key": "api_key", "value": "{{key}}", "inLocation": "query" }
        }
      },
      "expected": {
        "url": "https://api.example.test/items?api_key=k-1",
        "headers": [
          ["Content-Type", "application/x-www-form-urlencoded"],
          ["Accept", "application/json"]
        ],
        "body": "name=ada",
        "missingVars": []
      }
    },
    {
      "name": "body 只有一个解析成空串的变量（先判空后模板化）",
      "env": {
        "empty": ""
      },
      "input": {
        "method": "POST",
        "urlPath": "/x",
        "baseUrl": "https://h.test",
        "params": [],
        "headers": [],
        "body": { "mode": "json", "content": "{{empty}}" },
        "auth": { "kind": "none" }
      },
      "expected": {
        "url": "https://h.test/x",
        "headers": [
          ["Content-Type", "application/json"],
          ["Accept", "application/json"]
        ],
        "body": "",
        "missingVars": []
      }
    },
    {
      "name": "路径里的变量解析成以斜杠开头时，拼接出的双斜杠要被收掉",
      "env": {
        "seg": "/api"
      },
      "input": {
        "method": "GET",
        "urlPath": "/v1{{seg}}",
        "baseUrl": "https://h.test",
        "params": [],
        "headers": [],
        "body": { "mode": "none", "content": "" },
        "auth": { "kind": "none" }
      },
      "expected": {
        "url": "https://h.test/v1/api",
        "headers": [["Accept", "application/json"]],
        "body": null,
        "missingVars": []
      }
    },
    {
      "name": "参数值里的空格编码成 %20（不是 form 编码的 +）",
      "env": {
        "q": "a b"
      },
      "input": {
        "method": "GET",
        "urlPath": "/search",
        "baseUrl": "https://h.test",
        "params": [{ "id": "p1", "key": "q", "value": "{{q}}", "enabled": true }],
        "headers": [],
        "body": { "mode": "none", "content": "" },
        "auth": { "kind": "none" }
      },
      "expected": {
        "url": "https://h.test/search?q=a%20b",
        "headers": [["Accept", "application/json"]],
        "body": null,
        "missingVars": []
      }
    },
    {
      "name": "空 key 的参数不进查询串，其中的变量也不报缺失",
      "env": {},
      "input": {
        "method": "GET",
        "urlPath": "/x",
        "baseUrl": "https://h.test",
        "params": [{ "id": "p1", "key": "", "value": "{{unknown}}", "enabled": true }],
        "headers": [],
        "body": { "mode": "none", "content": "" },
        "auth": { "kind": "none" }
      },
      "expected": {
        "url": "https://h.test/x",
        "headers": [["Accept", "application/json"]],
        "body": null,
        "missingVars": []
      }
    },
    {
      "name": "basic 鉴权：用户名与密码各自模板化，base64 按 UTF-8 字节",
      "env": {
        "u": "ada",
        "p": "s3cret"
      },
      "input": {
        "method": "GET",
        "urlPath": "/me",
        "baseUrl": "https://h.test",
        "params": [],
        "headers": [],
        "body": { "mode": "none", "content": "" },
        "auth": { "kind": "basic", "basic": { "username": "{{u}}", "password": "{{p}}" } }
      },
      "expected": {
        "url": "https://h.test/me",
        "headers": [
          ["Accept", "application/json"],
          ["Authorization", "Basic YWRhOnMzY3JldA=="]
        ],
        "body": null,
        "missingVars": []
      }
    },
    {
      "name": "apikey 落在 query 上，值里的空格同样编码成 %20",
      "env": {
        "k": "a b"
      },
      "input": {
        "method": "GET",
        "urlPath": "/items",
        "baseUrl": "https://h.test",
        "params": [],
        "headers": [],
        "body": { "mode": "none", "content": "" },
        "auth": {
          "kind": "apikey",
          "apikey": { "key": "api_key", "value": "{{k}}", "inLocation": "query" }
        }
      },
      "expected": {
        "url": "https://h.test/items?api_key=a%20b",
        "headers": [["Accept", "application/json"]],
        "body": null,
        "missingVars": []
      }
    },
    {
      "name": "路径参数替换进路径，不进查询串",
      "env": {},
      "input": {
        "method": "GET",
        "urlPath": "/users/{id}/posts/{postId}",
        "baseUrl": "https://h.test",
        "pathParams": [
          { "id": "pp1", "key": "id", "value": "42", "enabled": true },
          { "id": "pp2", "key": "postId", "value": "7", "enabled": true }
        ],
        "params": [],
        "headers": [],
        "body": { "mode": "none", "content": "" },
        "auth": { "kind": "none" }
      },
      "expected": {
        "url": "https://h.test/users/42/posts/7",
        "headers": [["Accept", "application/json"]],
        "body": null,
        "missingVars": [],
        "missingPathParams": []
      }
    },
    {
      "name": "路径参数的值按路径段编码（空格是 %20，斜杠是 %2F）",
      "env": {},
      "input": {
        "method": "GET",
        "urlPath": "/files/{name}",
        "baseUrl": "https://h.test",
        "pathParams": [{ "id": "pp1", "key": "name", "value": "a b/c", "enabled": true }],
        "params": [],
        "headers": [],
        "body": { "mode": "none", "content": "" },
        "auth": { "kind": "none" }
      },
      "expected": {
        "url": "https://h.test/files/a%20b%2Fc",
        "headers": [["Accept", "application/json"]],
        "body": null,
        "missingVars": [],
        "missingPathParams": []
      }
    },
    {
      "name": "路径参数缺值时占位符原样留着，并报出缺哪个",
      "env": {},
      "input": {
        "method": "GET",
        "urlPath": "/users/{id}",
        "baseUrl": "https://h.test",
        "pathParams": [],
        "params": [],
        "headers": [],
        "body": { "mode": "none", "content": "" },
        "auth": { "kind": "none" }
      },
      "expected": {
        "url": "https://h.test/users/{id}",
        "headers": [["Accept", "application/json"]],
        "body": null,
        "missingVars": [],
        "missingPathParams": ["id"]
      }
    },
    {
      "name": "路径参数的值先解析变量再替换",
      "env": { "uid": "42" },
      "input": {
        "method": "GET",
        "urlPath": "/users/{id}",
        "baseUrl": "https://h.test",
        "pathParams": [{ "id": "pp1", "key": "id", "value": "{{uid}}", "enabled": true }],
        "params": [],
        "headers": [],
        "body": { "mode": "none", "content": "" },
        "auth": { "kind": "none" }
      },
      "expected": {
        "url": "https://h.test/users/42",
        "headers": [["Accept", "application/json"]],
        "body": null,
        "missingVars": [],
        "missingPathParams": []
      }
    },
    {
      "name": "路径参数的值里还有没解析的变量时，这个路径参数算缺值",
      "env": {},
      "input": {
        "method": "GET",
        "urlPath": "/users/{id}",
        "baseUrl": "https://h.test",
        "pathParams": [{ "id": "pp1", "key": "id", "value": "{{uid}}", "enabled": true }],
        "params": [],
        "headers": [],
        "body": { "mode": "none", "content": "" },
        "auth": { "kind": "none" }
      },
      "expected": {
        "url": "https://h.test/users/{id}",
        "headers": [["Accept", "application/json"]],
        "body": null,
        "missingVars": ["uid"],
        "missingPathParams": ["id"]
      }
    },
    {
      "name": "同名的查询参数仍然进查询串，路径参数另算",
      "env": {},
      "input": {
        "method": "GET",
        "urlPath": "/users/{id}",
        "baseUrl": "https://h.test",
        "pathParams": [{ "id": "pp1", "key": "id", "value": "42", "enabled": true }],
        "params": [{ "id": "p1", "key": "id", "value": "7", "enabled": true }],
        "headers": [],
        "body": { "mode": "none", "content": "" },
        "auth": { "kind": "none" }
      },
      "expected": {
        "url": "https://h.test/users/42?id=7",
        "headers": [["Accept", "application/json"]],
        "body": null,
        "missingVars": [],
        "missingPathParams": []
      }
    },
    {
      "name": "模块格带代理时，模块地址与代理地址各自先解析变量，再做代理前缀替换",
      "env": {
        "host": "svc.internal:8080",
        "tenant": "acme"
      },
      "input": {
        "method": "GET",
        "urlPath": "/orders/list",
        "baseUrl": "http://{{host}}/api/a",
        "proxy": "https://gw.corp.com/{{tenant}}/api/a",
        "params": [],
        "headers": [],
        "body": { "mode": "none", "content": "" },
        "auth": { "kind": "none" }
      },
      "expected": {
        "url": "https://gw.corp.com/acme/api/a/orders/list",
        "headers": [["Accept", "application/json"]],
        "body": null,
        "missingVars": [],
        "missingPathParams": []
      }
    }
  ]
}
