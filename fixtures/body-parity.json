{
  "$comment": "请求体解析与装配规则的一致性样本。Rust 的 `core::body::resolve_body`（MCP 端）与 TS 的 `src/lib/body`（桌面端）读同一份本文件，产出必须逐条相同。样本钉的是**规则**：逐字段还是逐段模板化、空键与停用行算不算、百分号编码用哪套字符集、产物是文本还是没有请求体。**落单代理项那条规则不在本样本里**：JSON 里的 \\uD800 转义 serde_json 直接拒绝，两侧的读取器读不了整份样本；那条规则由 `src/lib/__tests__/lone-surrogate-encoding.test.ts` 与 `crates/simple-post-core/src/body_test.rs` 里那条用例分别钉住。",
  "cases": [
    {
      "name": "json：整段模板化",
      "vars": { "id": "7" },
      "body": { "mode": "json", "content": "{\"id\":{{id}}}" },
      "expected": { "text": "{\"id\":7}", "missing": [] }
    },
    {
      "name": "xml：整段模板化",
      "vars": { "id": "7" },
      "body": { "mode": "xml", "content": "<r id=\"{{id}}\"/>" },
      "expected": { "text": "<r id=\"7\"/>", "missing": [] }
    },
    {
      "name": "raw：整段模板化",
      "vars": { "id": "7" },
      "body": { "mode": "raw", "content": "id={{id}}" },
      "expected": { "text": "id=7", "missing": [] }
    },
    {
      "name": "none：没有请求体",
      "vars": {},
      "body": { "mode": "none", "content": "" },
      "expected": { "text": null, "missing": [] }
    },
    {
      "name": "空内容：没有请求体",
      "vars": {},
      "body": { "mode": "json", "content": "" },
      "expected": { "text": null, "missing": [] }
    },
    {
      "name": "form：逐字段模板化，空格编成 %20",
      "vars": { "token": "abc", "who": "Ada Lovelace" },
      "body": {
        "mode": "form",
        "content": "[{\"key\":\"a\",\"value\":\"{{token}}\",\"enabled\":true},{\"key\":\"who\",\"value\":\"{{who}}\",\"enabled\":true}]"
      },
      "expected": { "text": "a=abc&who=Ada%20Lovelace", "missing": [] }
    },
    {
      "name": "form：替换出来的值里有引号，整份 JSON 仍然完好",
      "vars": { "q": "say \"hi\"" },
      "body": {
        "mode": "form",
        "content": "[{\"key\":\"q\",\"value\":\"{{q}}\",\"enabled\":true}]"
      },
      "expected": { "text": "q=say%20%22hi%22", "missing": [] }
    },
    {
      "name": "form：值里的 & 与 + 走 encodeURIComponent 的字符集",
      "vars": { "q": "a&b+c=d" },
      "body": {
        "mode": "form",
        "content": "[{\"key\":\"q\",\"value\":\"{{q}}\",\"enabled\":true}]"
      },
      "expected": { "text": "q=a%26b%2Bc%3Dd", "missing": [] }
    },
    {
      "name": "form：值里的替换字符按 U+FFFD 的字节编码",
      "vars": { "q": "\ufffd" },
      "body": {
        "mode": "form",
        "content": "[{\"key\":\"q\",\"value\":\"{{q}}\",\"enabled\":true}]"
      },
      "expected": { "text": "q=%EF%BF%BD", "missing": [] }
    },
    {
      "name": "form：停用的行不进正文，其中的变量也不报缺失",
      "vars": {},
      "body": {
        "mode": "form",
        "content": "[{\"key\":\"a\",\"value\":\"1\",\"enabled\":true},{\"key\":\"b\",\"value\":\"{{gone}}\",\"enabled\":false}]"
      },
      "expected": { "text": "a=1", "missing": [] }
    },
    {
      "name": "form：空键的行不进正文，其中的变量也不报缺失",
      "vars": {},
      "body": {
        "mode": "form",
        "content": "[{\"key\":\"\",\"value\":\"{{gone}}\",\"enabled\":true}]"
      },
      "expected": { "text": "", "missing": [] }
    },
    {
      "name": "form：没写 enabled 的行按参与发送处理",
      "vars": {},
      "body": { "mode": "form", "content": "[{\"key\":\"a\",\"value\":\"1\"}]" },
      "expected": { "text": "a=1", "missing": [] }
    },
    {
      "name": "form：旧格式的 urlencoded 原文按旧格式读",
      "vars": {},
      "body": { "mode": "form", "content": "a=1&b=2" },
      "expected": { "text": "a=1&b=2", "missing": [] }
    },
    {
      "name": "form：旧格式里没有等号的行，值是空串",
      "vars": {},
      "body": { "mode": "form", "content": "a&b=2" },
      "expected": { "text": "a=&b=2", "missing": [] }
    },
    {
      "name": "form：行数组里有一行类型不对，整份作废",
      "vars": {},
      "body": { "mode": "form", "content": "[{\"key\":\"a\",\"value\":10}]" },
      "expected": { "text": "", "missing": [] }
    },
    {
      "name": "form：解析不到的变量按首次出现排序报出来",
      "vars": {},
      "body": {
        "mode": "form",
        "content": "[{\"key\":\"a\",\"value\":\"{{gone}}\",\"enabled\":true},{\"key\":\"b\",\"value\":\"{{alsoGone}}\",\"enabled\":true}]"
      },
      "expected": {
        "text": "a=%7B%7Bgone%7D%7D&b=%7B%7BalsoGone%7D%7D",
        "missing": ["gone", "alsoGone"]
      }
    },
    {
      "name": "multipart：逐分片模板化，文件分片只带路径",
      "vars": { "title": "报告" },
      "body": {
        "mode": "multipart",
        "content": "[{\"name\":\"title\",\"value\":\"{{title}}\"},{\"name\":\"f\",\"filename\":\"a.bin\",\"path\":\"/tmp/a.bin\"}]"
      },
      "expected": {
        "text": "[{\"name\":\"title\",\"value\":\"报告\",\"enabled\":true},{\"name\":\"f\",\"value\":\"\",\"enabled\":true,\"filename\":\"a.bin\",\"path\":\"/tmp/a.bin\"}]",
        "missing": []
      }
    },
    {
      "name": "multipart：分片名与内容里都能带变量",
      "vars": { "field": "userId" },
      "body": {
        "mode": "multipart",
        "content": "[{\"name\":\"{{field}}\",\"value\":\"{{field}}\"}]"
      },
      "expected": {
        "text": "[{\"name\":\"userId\",\"value\":\"userId\",\"enabled\":true}]",
        "missing": []
      }
    },
    {
      "name": "binary：文件描述原样带出去，字节由执行层按路径现读",
      "vars": {},
      "body": {
        "mode": "binary",
        "content": "{\"name\":\"a.bin\",\"size\":3,\"contentType\":\"application/octet-stream\",\"path\":\"/tmp/a.bin\"}"
      },
      "expected": {
        "text": "{\"name\":\"a.bin\",\"size\":3,\"contentType\":\"application/octet-stream\",\"path\":\"/tmp/a.bin\"}",
        "missing": []
      },
      "expectedContentType": "application/octet-stream"
    },
    {
      "name": "binary：Content-Type 取文件自己的类型",
      "vars": {},
      "body": {
        "mode": "binary",
        "content": "{\"name\":\"a.png\",\"size\":3,\"contentType\":\"image/png\",\"path\":\"/tmp/a.png\"}"
      },
      "expected": {
        "text": "{\"name\":\"a.png\",\"size\":3,\"contentType\":\"image/png\",\"path\":\"/tmp/a.png\"}",
        "missing": []
      },
      "expectedContentType": "image/png"
    },
    {
      "name": "binary：内容读不出文件描述时没有 body",
      "vars": {},
      "body": { "mode": "binary", "content": "not json" },
      "expected": { "text": null, "missing": [] },
      "expectedContentType": "application/octet-stream"
    }
  ]
}
