          "parentId": null,
          "kind": "module",
          "name": "核心",
          "sortOrder": 0
        },
        {
          "id": "c1",
          "rootId": "p1",
          "parentId": "m1",
          "kind": "collection",
          "name": "订单",
          "sortOrder": 0
