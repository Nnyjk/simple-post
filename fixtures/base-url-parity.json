{
  "$comment": "base URL 的解析与代理前缀替换。Rust 侧 `crates/simple-post-mcp/src/variable_fill/base_url.rs` 的 `resolve_base_url_with` 与 `apply_proxy`、渲染进程侧 `src/lib/url.ts` 的 `resolveEndpointBaseUrl` 与 `applyProxy` 读同一份文件。两份实现各写一遍规则，只有共享样本能钉住它们没分叉。`cases` 覆盖解析：端点自己的 `baseUrlOverride` 优先，否则读环境里「模块 × 环境」那一格，没有回退层。`proxyCases` 覆盖代理前缀替换：请求地址里那个作为前缀的模块地址被换成实际访问地址，其余部分原样保留。两侧的读取器都必须用 `deny_unknown_fields` 并数一遍条目数，免得键名漂了导致整条测试空转。",
  "cases": [
    {
      "name": "端点带自定义主机时用自己的地址",
      "endpoint": { "baseUrlOverride": "https://custom.example.com" },
      "env": {
        "moduleBaseUrls": {
          "mod_a": { "url": "https://mod-a.example.com" }
        }
      },
      "moduleId": "mod_a",
      "expected": {
        "baseUrl": "https://custom.example.com",
        "proxy": null,
        "source": "override"
      }
    },
    {
      "name": "端点的 override 是空串时表示自定义但不加前缀",
      "endpoint": { "baseUrlOverride": "" },
      "env": {
        "moduleBaseUrls": {
          "mod_a": { "url": "https://mod-a.example.com" }
        }
      },
      "moduleId": "mod_a",
      "expected": { "baseUrl": "", "proxy": null, "source": "override" }
    },
    {
      "name": "端点带自定义主机时不套用那一格的代理",
      "endpoint": { "baseUrlOverride": "https://custom.example.com" },
      "env": {
        "moduleBaseUrls": {
          "mod_a": {
            "url": "http://svc.internal:8080/api/a",
            "proxy": "https://gw.corp.com/api/xxxx/a"
          }
        }
      },
      "moduleId": "mod_a",
      "expected": {
        "baseUrl": "https://custom.example.com",
        "proxy": null,
        "source": "override"
      }
    },
    {
      "name": "端点没给 override 时读模块在环境里的那一格",
      "endpoint": { "baseUrlOverride": null },
      "env": {
        "moduleBaseUrls": {
          "mod_a": { "url": "https://mod-a.example.com" }
        }
      },
      "moduleId": "mod_a",
      "expected": {
        "baseUrl": "https://mod-a.example.com",
        "proxy": null,
        "source": "module"
      }
    },
    {
      "name": "那一格带代理时地址与代理一起给出",
      "endpoint": { "baseUrlOverride": null },
      "env": {
        "moduleBaseUrls": {
          "mod_a": {
            "url": "http://svc.internal:8080/api/a",
            "proxy": "https://gw.corp.com/api/xxxx/a"
          }
        }
      },
      "moduleId": "mod_a",
      "expected": {
        "baseUrl": "http://svc.internal:8080/api/a",
        "proxy": "https://gw.corp.com/api/xxxx/a",
        "source": "module"
      }
    },
    {
      "name": "两个模块的地址互不相干",
      "endpoint": { "baseUrlOverride": null },
      "env": {
        "moduleBaseUrls": {
          "mod_a": { "url": "https://mod-a.example.com" },
          "mod_b": { "url": "https://mod-b.example.com" }
        }
      },
      "moduleId": "mod_b",
      "expected": {
        "baseUrl": "https://mod-b.example.com",
        "proxy": null,
        "source": "module"
      }
    },
    {
      "name": "模块没有那一格时解析不出东西",
      "endpoint": { "baseUrlOverride": null },
      "env": {
        "moduleBaseUrls": {
          "mod_b": { "url": "https://mod-b.example.com" }
        }
      },
      "moduleId": "mod_a",
      "expected": { "baseUrl": "", "proxy": null, "source": "none" }
    },
    {
      "name": "那一格是空串时解析不出东西",
      "endpoint": { "baseUrlOverride": null },
      "env": {
        "moduleBaseUrls": {
          "mod_a": { "url": "" }
        }
      },
      "moduleId": "mod_a",
      "expected": { "baseUrl": "", "proxy": null, "source": "none" }
    },
    {
      "name": "那一格只有代理没有地址时解析不出东西",
      "endpoint": { "baseUrlOverride": null },
      "env": {
        "moduleBaseUrls": {
          "mod_a": { "url": "", "proxy": "https://gw.corp.com/api/xxxx/a" }
        }
      },
      "moduleId": "mod_a",
      "expected": { "baseUrl": "", "proxy": null, "source": "none" }
    },
    {
      "name": "模块未知时没有格子可读",
      "endpoint": { "baseUrlOverride": null },
      "env": {
        "moduleBaseUrls": {
          "mod_a": { "url": "https://mod-a.example.com" }
        }
      },
      "moduleId": null,
      "expected": { "baseUrl": "", "proxy": null, "source": "none" }
    },
    {
      "name": "环境缺席时解析不出东西",
      "endpoint": { "baseUrlOverride": null },
      "env": null,
      "moduleId": "mod_a",
      "expected": { "baseUrl": "", "proxy": null, "source": "none" }
    }
  ],
  "proxyCases": [
    {
      "name": "代理地址整体替换模块地址的前缀",
      "baseUrl": "http://svc.internal:8080/api/a",
      "proxy": "https://gw.corp.com/api/xxxx/a",
      "url": "http://svc.internal:8080/api/a/orders/list",
      "expected": "https://gw.corp.com/api/xxxx/a/orders/list"
    },
    {
      "name": "没有代理时地址原样保留",
      "baseUrl": "http://svc.internal:8080/api/a",
      "proxy": null,
      "url": "http://svc.internal:8080/api/a/orders/list",
      "expected": "http://svc.internal:8080/api/a/orders/list"
    },
    {
      "name": "代理是空串时地址原样保留",
      "baseUrl": "http://svc.internal:8080/api/a",
      "proxy": "",
      "url": "http://svc.internal:8080/api/a/orders/list",
      "expected": "http://svc.internal:8080/api/a/orders/list"
    },
    {
      "name": "地址与前缀完全相同时不改动其余部分",
      "baseUrl": "https://api.example.com",
      "proxy": "https://gw.corp.com",
      "url": "https://api.example.com",
      "expected": "https://gw.corp.com"
    },
    {
      "name": "前缀只在路径边界上命中",
      "baseUrl": "http://svc.internal:8080/api",
      "proxy": "https://gw.corp.com",
      "url": "http://svc.internal:8080/apixyz/orders",
      "expected": "http://svc.internal:8080/apixyz/orders"
    },
    {
      "name": "模块地址带尾部斜杠时按去掉斜杠后的前缀命中",
      "baseUrl": "http://svc.internal:8080/api/",
      "proxy": "https://gw.corp.com",
      "url": "http://svc.internal:8080/api/orders",
      "expected": "https://gw.corp.com/orders"
    },
    {
      "name": "查询串紧跟前缀时也算命中",
      "baseUrl": "http://svc.internal:8080/api",
      "proxy": "https://gw.corp.com",
      "url": "http://svc.internal:8080/api?x=1",
      "expected": "https://gw.corp.com?x=1"
    },
    {
      "name": "地址为空时不做替换",
      "baseUrl": "",
      "proxy": "https://gw.corp.com",
      "url": "/orders",
      "expected": "/orders"
    },
    {
      "name": "请求打的是另一个主机时不做替换",
      "baseUrl": "http://svc.internal:8080/api/a",
      "proxy": "https://gw.corp.com/api/xxxx/a",
      "url": "https://other.example.com/orders",
      "expected": "https://other.example.com/orders"
    }
  ]
}
