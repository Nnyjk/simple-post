{
  "$comment": "base URL 的解析与路径前缀改写。Rust 侧 `crates/simple-post-mcp/src/variable_fill/base_url.rs` 的 `resolve_base_url` 与核心库 `crates/simple-post-core/src/url.rs` 的 `apply_rewrite`、渲染进程侧 `src/lib/url.ts` 的 `resolveEndpointBaseUrl` 与 `applyRewrite` 读同一份文件。两份实现各写一遍规则，只有共享样本能让两份实现保持一致。`cases` 覆盖解析：端点自己的 `baseUrlOverride` 优先，否则读环境里「环境 × 模块」那一格，没有回退层；路径前缀改写规则与地址来源无关，端点自带主机时路径照样改写。`rewriteCases` 覆盖改写规则：端点自己 URL 的路径前缀从 `from` 换成 `to`，命中要求落在路径边界上（`/`），模块地址自带的路径段不参与匹配；目标是绝对地址时拒绝改写；起点是 `/` 时指的是路径根；端点自带完整地址时改写作用在它的路径上。两侧的读取器都必须用 `deny_unknown_fields` 并断言条目数（`cases` 11 条、`rewriteCases` 13 条），免得键名漂了导致整条测试空转。",
  "cases": [
    {
      "name": "端点带自定义主机时用自己的地址",
      "endpoint": {
        "baseUrlOverride": "https://custom.example.com"
      },
      "env": {
        "moduleBaseUrls": {
          "mod_a": {
            "url": "https://mod-a.example.com"
          }
        }
      },
      "moduleId": "mod_a",
      "expected": {
        "baseUrl": "https://custom.example.com",
        "rewrite": null,
        "source": "override"
      }
    },
    {
      "name": "端点的 override 是空串时表示自定义但不加前缀",
      "endpoint": {
        "baseUrlOverride": ""
      },
      "env": {
        "moduleBaseUrls": {
          "mod_a": {
            "url": "https://mod-a.example.com"
          }
        }
      },
      "moduleId": "mod_a",
      "expected": {
        "baseUrl": "",
        "rewrite": null,
        "source": "override"
      }
    },
    {
      "name": "端点带自定义主机时那一格的路径改写规则照样生效",
      "endpoint": {
        "baseUrlOverride": "https://custom.example.com"
      },
      "env": {
        "moduleBaseUrls": {
          "mod_a": {
            "url": "http://svc.internal:8080/api/a",
            "rewrite": {
              "from": "/api/air",
              "to": "/api/project-a/air"
            }
          }
        }
      },
      "moduleId": "mod_a",
      "expected": {
        "baseUrl": "https://custom.example.com",
        "rewrite": {
          "from": "/api/air",
          "to": "/api/project-a/air"
        },
        "source": "override"
      }
    },
    {
      "name": "端点没给 override 时读模块在环境里的那一格",
      "endpoint": {
        "baseUrlOverride": null
      },
      "env": {
        "moduleBaseUrls": {
          "mod_a": {
            "url": "https://mod-a.example.com"
          }
        }
      },
      "moduleId": "mod_a",
      "expected": {
        "baseUrl": "https://mod-a.example.com",
        "rewrite": null,
        "source": "module"
      }
    },
    {
      "name": "那一格带改写规则时地址与规则一起给出",
      "endpoint": {
        "baseUrlOverride": null
      },
      "env": {
        "moduleBaseUrls": {
          "mod_a": {
            "url": "127.0.0.1:8080",
            "rewrite": {
              "from": "/api/air",
              "to": "/api/project-a/air"
            }
          }
        }
      },
      "moduleId": "mod_a",
      "expected": {
        "baseUrl": "127.0.0.1:8080",
        "rewrite": {
          "from": "/api/air",
          "to": "/api/project-a/air"
        },
        "source": "module"
      }
    },
    {
      "name": "两个模块的地址互不相干",
      "endpoint": {
        "baseUrlOverride": null
      },
      "env": {
        "moduleBaseUrls": {
          "mod_a": {
            "url": "https://mod-a.example.com"
          },
          "mod_b": {
            "url": "https://mod-b.example.com"
          }
        }
      },
      "moduleId": "mod_b",
      "expected": {
        "baseUrl": "https://mod-b.example.com",
        "rewrite": null,
        "source": "module"
      }
    },
    {
      "name": "模块没有那一格时解析不出东西",
      "endpoint": {
        "baseUrlOverride": null
      },
      "env": {
        "moduleBaseUrls": {
          "mod_b": {
            "url": "https://mod-b.example.com"
          }
        }
      },
      "moduleId": "mod_a",
      "expected": {
        "baseUrl": "",
        "rewrite": null,
        "source": "none"
      }
    },
    {
      "name": "那一格是空串时解析不出东西",
      "endpoint": {
        "baseUrlOverride": null
      },
      "env": {
        "moduleBaseUrls": {
          "mod_a": {
            "url": ""
          }
        }
      },
      "moduleId": "mod_a",
      "expected": {
        "baseUrl": "",
        "rewrite": null,
        "source": "none"
      }
    },
    {
      "name": "那一格只有改写规则没有地址时解析不出地址",
      "endpoint": {
        "baseUrlOverride": null
      },
      "env": {
        "moduleBaseUrls": {
          "mod_a": {
            "url": "",
            "rewrite": {
              "from": "/api/air",
              "to": "/api/project-a/air"
            }
          }
        }
      },
      "moduleId": "mod_a",
      "expected": {
        "baseUrl": "",
        "rewrite": {
          "from": "/api/air",
          "to": "/api/project-a/air"
        },
        "source": "none"
      }
    },
    {
      "name": "模块未知时没有格子可读",
      "endpoint": {
        "baseUrlOverride": null
      },
      "env": {
        "moduleBaseUrls": {
          "mod_a": {
            "url": "https://mod-a.example.com"
          }
        }
      },
      "moduleId": null,
      "expected": {
        "baseUrl": "",
        "rewrite": null,
        "source": "none"
      }
    },
    {
      "name": "环境缺席时解析不出东西",
      "endpoint": {
        "baseUrlOverride": null
      },
      "env": null,
      "moduleId": "mod_a",
      "expected": {
        "baseUrl": "",
        "rewrite": null,
        "source": "none"
      }
    }
  ],
  "rewriteCases": [
    {
      "name": "起点命中时换成目标",
      "url": "/api/air/xxxxx",
      "rewrite": {
        "from": "/api/air",
        "to": "/api/project-a/air"
      },
      "expected": "/api/project-a/air/xxxxx"
    },
    {
      "name": "没有规则时地址原样保留",
      "url": "/api/air/xxxxx",
      "rewrite": null,
      "expected": "/api/air/xxxxx"
    },
    {
      "name": "起点为空时地址原样保留",
      "url": "/api/air/xxxxx",
      "rewrite": {
        "from": "",
        "to": "/api/project-a/air"
      },
      "expected": "/api/air/xxxxx"
    },
    {
      "name": "地址与起点完全相同时不改动其余部分",
      "url": "/api/air",
      "rewrite": {
        "from": "/api/air",
        "to": "/api/project-a/air"
      },
      "expected": "/api/project-a/air"
    },
    {
      "name": "起点只在路径边界上命中",
      "url": "/api/airplane/xxxxx",
      "rewrite": {
        "from": "/api/air",
        "to": "/api/project-a/air"
      },
      "expected": "/api/airplane/xxxxx"
    },
    {
      "name": "起点带尾部斜杠时按去掉斜杠后的起点命中",
      "url": "/api/air/xxxxx",
      "rewrite": {
        "from": "/api/air/",
        "to": "/api/project-a/air"
      },
      "expected": "/api/project-a/air/xxxxx"
    },
    {
      "name": "查询串紧跟起点时也算命中",
      "url": "/api/air?x=1",
      "rewrite": {
        "from": "/api/air",
        "to": "/api/project-a/air"
      },
      "expected": "/api/project-a/air?x=1"
    },
    {
      "name": "目标为空时把这段前缀去掉",
      "url": "/api/air/xxxxx",
      "rewrite": {
        "from": "/api/air",
        "to": ""
      },
      "expected": "/xxxxx"
    },
    {
      "name": "起点与地址开头不一致时不改写",
      "url": "/api/air/xxxxx",
      "rewrite": {
        "from": "/api/other",
        "to": "/api/project-a/other"
      },
      "expected": "/api/air/xxxxx"
    },
    {
      "name": "起点是路径根时整条路径换到目标底下",
      "url": "/api/air/list",
      "rewrite": {
        "from": "/",
        "to": "/gateway"
      },
      "expected": "/gateway/api/air/list"
    },
    {
      "name": "起点是路径根且地址就是根时换到目标底下",
      "url": "/",
      "rewrite": {
        "from": "/",
        "to": "/gateway"
      },
      "expected": "/gateway/"
    },
    {
      "name": "目标带 scheme 时不改写",
      "url": "/api/air/xxxxx",
      "rewrite": {
        "from": "/api/air",
        "to": "https://other.example/api"
      },
      "expected": "/api/air/xxxxx"
    },
    {
      "name": "端点自带完整地址时只改它的路径",
      "url": "https://h.example/api/air/list?x=1",
      "rewrite": {
        "from": "/api/air",
        "to": "/api/project-a/air"
      },
      "expected": "https://h.example/api/project-a/air/list?x=1"
    }
  ]
}
