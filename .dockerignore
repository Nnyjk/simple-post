# .dockerignore — keep the build context small and free of secrets.
# `docker build -f Dockerfile.web .` reads this file from the context root.

# Build outputs (rebuilt inside the container's Rust stage)
target/
**/target/

# Frontend dev artifacts (we copy `dist/` explicitly in the Dockerfile,
# so node_modules and the source tree itself are noise)
node_modules/
**/node_modules/
src/
**/src/

# Tauri build outputs
src-tauri/gen/
src-tauri/target/

# VCS / scratch / IDE noise
.git/
.gitattributes
.idea/
*.swp
*.swo

# Agent scratch space — never ship
.scratch/

# Local data / dev SQLite files (security: never let a developer's local
# DB end up in the image even if they accidentally mount the wrong ctx)
*.db
*.db-journal
*.db-wal
*.db-shm
data/
data/

# Workflow / CI artefacts
.github/

# Docs that aren't needed for runtime
docs/

# OS / editor noise
.DS_Store
Thumbs.db
*.log
logs/

# Tests / coverage
coverage/
*.lcov

# The standalone MCP server crate ships as a workspace member, but
# the web binary statically links it as a path dependency and `cargo`
# compiles its source inside the builder stage. Excluding the source
# directory from the build context just keeps the context small —
# cargo path resolution still works because the build context is the
# repo root.
crates/simple-post-mcp/

# Bash history / dotenv files (security)
.bash_history
.env
.env.*
!.env.example