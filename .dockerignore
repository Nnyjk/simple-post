# .dockerignore — keep the build context small and free of secrets.
# `docker build -f Dockerfile.web .` reads this file from the context root.

# Build outputs (rebuilt inside the container's Rust stage)
target/
**/target/

# Frontend dev artifacts (we copy `dist/` explicitly in the Dockerfile,
# so node_modules and the source tree itself are noise)
node_modules/
**/node_modules/
src/
**/src/

# Tauri build outputs
src-tauri/gen/
src-tauri/target/

# npm package caches / lockfiles (npm wrapper builds separately)
packages/**/node_modules/
packages/**/bin/

# VCS / scratch / IDE noise
.git/
.gitattributes
.idea/
*.swp
*.swo

# Agent scratch space — never ship
.scratch/

# Local data / dev SQLite files (security: never let a developer's local
# DB end up in the image even if they accidentally mount the wrong ctx)
*.db
*.db-journal
*.db-wal
*.db-shm
data/
data/

# Workflow / CI artefacts
.github/

# Docs that aren't needed for runtime
docs/

# OS / editor noise
.DS_Store
Thumbs.db
*.log
logs/

# Tests / coverage
coverage/
*.lcov

# Build-time before dev feature is wired: Cargo workspace members that
# aren't needed for the web shape (commit 3 split these out; the web
# binary only depends on simple-post + simple-post-core + transitive deps)
crates/simple-post-mcp/

# Bash history / dotenv files (security)
.bash_history
.env
.env.*
!.env.example

# The `packages/simple-post-mcp/` dir has node_modules + npm tarballs
# that bloat the context (the Dockerfile doesn't need them).
packages/